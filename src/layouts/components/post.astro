---
import { settings } from "@/config/config.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import dateFormat from "@/lib/utils/dateFormat";
import { plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
const { post_folder } = settings;
const { summary_length } = settings;

type Props = CollectionEntry<"posts">;
const { image, title, date, categories } = Astro.props.data;
const { body, id } = Astro.props;
---

<div class="post group transition-transform duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:transform-none">
  <div class="relative">
    {
      image && (     
      <a href={`/${post_folder}/${id}`}
      class="block overflow-hidden rounded py-0.5 hover:text-primary dark:hover:text-darkmode-primary">
        <Image
          class="aspect-[4/3] w-full rounded object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none"
          src={image}
          alt={title || ""}
          width={405}
          height={304}
          format="webp"
          loading="lazy"
        />
       </a>
      )
    }

    <ul class="absolute top-3 left-2 flex flex-wrap items-center">
      {
        categories?.slice(0,1).map((tag) => (
          <li class="font-secondary m-2 inline-flex h-7 rounded-[35px] bg-primary px-3 py-0 text-white dark:bg-darkmode-primary">
            <a
              aria-label="categories"
              class="uppercase"
              href={`/categories/${slugify(tag)}`}>
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <h3 class="h5 mb-2 mt-4">
    <a
      href={`/${post_folder}/${id}`}
      class="block py-0.5 transition-colors duration-200 group-hover:text-primary hover:text-primary dark:group-hover:text-darkmode-primary dark:hover:text-darkmode-primary motion-reduce:transition-none">
      {title}
    </a>
  </h3>
  <ul class="flex items-center space-x-4 mb-2">
    <li class="inline-flex items-center font-secondary text-xs leading-3">
      <DynamicIcon className="mr-1.5" icon="FaRegCalendar" />
      {dateFormat(date!)}
    </li>
  </ul>
  <p>{plainify(body!).slice(0, summary_length)}</p>
  <a
    title={title}
    aria-label={title}
    class="btn btn-outline-primary mt-4"
    href={`/${post_folder}/${id}`}>
    <span class="sr-only">{title}</span>
    Leer más
  </a>
</div>
